BACKUP_ENCRYPTION_KEY=
VITE_SENTRY_DSN=
# Public, non-secret exact release/build identifier for OMR field evidence.
# Production should inject a unique immutable value (prefer deployment Git SHA).
VITE_APP_RELEASE_ID=
# Optional backend override; Render normally supplies RENDER_GIT_COMMIT automatically.
APP_RELEASE_ID=
# OMR continuous queue Phase 3: fail-closed pilot. Không đưa ID thật vào Git.
VITE_CONTINUOUS_SCAN_V2=true
VITE_CONTINUOUS_SCAN_PILOT_REQUIRED=true
VITE_CONTINUOUS_SCAN_PILOT_PARISH_IDS=
VITE_CONTINUOUS_SCAN_PILOT_USER_IDS=
# Tăng revision để reset circuit local sau khi đã khắc phục và phát hành bản mới.
VITE_CONTINUOUS_SCAN_CIRCUIT_REVISION=1
TURSO_URL=
TURSO_AUTH_TOKEN=
DB_PATH=
# Priority: SERVER_PORT > PORT > 3001. Railway injects PORT (8080) — đừng override trừ khi chắc chắn.
PORT=3000
SERVER_PORT=
HOST=0.0.0.0
# Immutable installation identity. Production startup fails closed when missing
# or when any persisted parish_id differs from this value.
DEPLOYMENT_PARISH_ID=gia-ton
# Server-authoritative civil timezone for date-only parish rules (service terms).
# Must be a valid IANA timezone; invalid configuration aborts startup.
PARISH_TIME_ZONE=Asia/Ho_Chi_Minh
# Development/test bootstrap only. Production code always disables this even
# if the environment accidentally sets it to true.
OPERATIONS_ADMIN_MUTATION_OVERRIDE=true
JWT_SECRET=
JWT_REFRESH_SECRET=
# Protected principal = user ID + parish ID + admin role. Set the actual ID in production.
SUPER_ADMIN_ID=
# Compatibility for dev/test without DEPLOYMENT_PARISH_ID. Production protected
# principal always uses DEPLOYMENT_PARISH_ID.
SUPER_ADMIN_PARISH_ID=gia-ton
# SEC-HMAC-1 (2026-08-24): BẮT BUỘC ở production — secret riêng để ký HMAC cho QR
# phiếu điểm/chứng nhận. Không còn fallback JWT_SECRET/hardcode khi prod.
# Nên là chuỗi random ≥32 byte, KHÔNG dùng lại JWT_SECRET.
REPORT_HMAC_SECRET=
# Bắt buộc trước lần khởi tạo DB trống đầu tiên; không có default.
# 8–128 ký tự, có ít nhất 1 chữ hoa, 1 chữ số và 1 ký tự đặc biệt.
# Sau khi DB đã có user, startup không dùng biến này để reset mật khẩu hiện hữu.
SEED_ADMIN_PASSWORD=
CLIENT_ORIGIN=
# Ops/backup: OPS_TOKEN bảo vệ /ready /metrics. Với TURSO remote, R2_* và
# BACKUP_ENCRYPTION_KEY (32 byte: 64 hex hoặc base64) là bắt buộc để backup chạy.
OPS_TOKEN=
# OBS-2 (2026-08-24): Sentry node — opt-in. Set DSN để bật error aggregation phía
# server; thiếu DSN → hoàn toàn vô hiệu (structured console log vẫn hoạt động).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
AUTO_BACKUP_ENABLED=
AUTO_BACKUP_HOUR=
BACKUP_RETENTION_COUNT=
# Optional Operations receipt response compaction. Leave empty until the parish
# data-retention policy approves a duration; key/hash tombstones are never deleted.
OPERATIONS_RECEIPT_RESPONSE_RETENTION_DAYS=
BACKUP_DIR=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Restore drill only. Target must be a fresh disposable database and must never
# equal TURSO_URL. Compute RESTORE_TARGET_FINGERPRINT from the normalized target
# URL as documented in DEPLOYMENT_GUIDE.md; never commit credentials.
ALLOW_BACKUP_RESTORE=false
RESTORE_DATABASE_URL=
RESTORE_DATABASE_AUTH_TOKEN=
RESTORE_TARGET_FINGERPRINT=
# Optional read-only audit target. If blank, audit scripts use TURSO_URL/DB_PATH.
AUDIT_DATABASE_URL=
AUDIT_DATABASE_AUTH_TOKEN=
OPERATIONS_AUTHORITY_INVENTORY_INCLUDE_PARISH_ID=false
DEPLOYMENT_INVENTORY_INCLUDE_PARISH_ID=false
PROMOTION_INVENTORY_INCLUDE_PARISH_ID=false
SUNDAY_READINESS_INCLUDE_PARISH_ID=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# ADR-095 native push — Android FCM HTTP v1. JSON must include project_id,
# client_email and private_key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# ADR-095 native push — iOS APNs token auth. APNS_PRIVATE_KEY accepts raw PEM
# or a secret whose newlines are escaped as \\n. Never commit the .p8 key.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.tnttvn.app
APNS_ENVIRONMENT=production
