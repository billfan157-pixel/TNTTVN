BACKUP_ENCRYPTION_KEY=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VITE_SENTRY_DSN=
# Public, non-secret exact release/build identifier for OMR field evidence.
# Production should inject a unique immutable value (prefer deployment Git SHA).
VITE_APP_RELEASE_ID=
# Optional backend override; Render normally supplies RENDER_GIT_COMMIT automatically.
APP_RELEASE_ID=
# OMR continuous queue Phase 3: fail-closed pilot. Không đưa ID thật vào Git.
VITE_CONTINUOUS_SCAN_V2=true
VITE_CONTINUOUS_SCAN_PILOT_REQUIRED=true
VITE_CONTINUOUS_SCAN_PILOT_PARISH_IDS=
VITE_CONTINUOUS_SCAN_PILOT_USER_IDS=
# Tăng revision để reset circuit local sau khi đã khắc phục và phát hành bản mới.
VITE_CONTINUOUS_SCAN_CIRCUIT_REVISION=1
TURSO_URL=
TURSO_AUTH_TOKEN=
DB_PATH=
# Priority: SERVER_PORT > PORT > 3001. Railway injects PORT (8080) — đừng override trừ khi chắc chắn.
PORT=3000
SERVER_PORT=
HOST=0.0.0.0
JWT_SECRET=
JWT_REFRESH_SECRET=
# SEC-HMAC-1 (2026-08-24): BẮT BUỘC ở production — secret riêng để ký HMAC cho QR
# phiếu điểm/chứng nhận. Không còn fallback JWT_SECRET/hardcode khi prod.
# Nên là chuỗi random ≥32 byte, KHÔNG dùng lại JWT_SECRET.
REPORT_HMAC_SECRET=
# Bắt buộc trước lần khởi tạo DB trống đầu tiên; không có default.
# 8–128 ký tự, có ít nhất 1 chữ hoa, 1 chữ số và 1 ký tự đặc biệt.
# Sau khi DB đã có user, startup không dùng biến này để reset mật khẩu hiện hữu.
SEED_ADMIN_PASSWORD=
CLIENT_ORIGIN=
# Ops/backup: OPS_TOKEN bảo vệ /ready /metrics. Với TURSO remote, R2_* và
# BACKUP_ENCRYPTION_KEY (32 byte: 64 hex hoặc base64) là bắt buộc để backup chạy.
OPS_TOKEN=
# OBS-2 (2026-08-24): Sentry node — opt-in. Set DSN để bật error aggregation phía
# server; thiếu DSN → hoàn toàn vô hiệu (console log + Telegram alert vẫn hoạt động).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
AUTO_BACKUP_ENABLED=
AUTO_BACKUP_HOUR=
BACKUP_RETENTION_COUNT=
BACKUP_DIR=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# ADR-095 native push — Android FCM HTTP v1. JSON must include project_id,
# client_email and private_key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# ADR-095 native push — iOS APNs token auth. APNS_PRIVATE_KEY accepts raw PEM
# or a secret whose newlines are escaped as \\n. Never commit the .p8 key.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.tnttvn.app
APNS_ENVIRONMENT=production
