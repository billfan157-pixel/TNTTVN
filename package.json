{
  "name": "brave-davinci",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "clean:vite": "node -e \"import('node:fs').then(fs => fs.rmSync('node_modules/.vite',{recursive:true,force:true})).catch(() => {})\"",
    "dev": "node scripts/dev-all.mjs",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "node scripts/dev-all.mjs",
    "prebuild": "node -e \"import('node:fs').then(fs => fs.rmSync('node_modules/.vite',{recursive:true,force:true})).catch(() => {})\"",
    "build:server": "cd server && tsc",
    "build": "tsc -b && npm run build:server && vite build",
    "build:frontend": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "verify:ci": "npm run lint && npm run lint:ds && npm run build && npm run test:coverage -- --fileParallelism=false",
    "test": "vitest run",
    "test:security-critical": "vitest run src/__tests__/deploymentSecurityContract.test.ts server/src/__tests__/security/auth-cookie.test.ts server/src/__tests__/security/authorization-matrix-audit-b.test.ts server/src/__tests__/security/tenantIsolation.test.ts server/src/__tests__/rbac-matrix.test.ts server/src/__tests__/goliveVerification.test.ts server/src/__tests__/smokeTestPhase15.test.ts --fileParallelism=false",
    "test:coverage": "vitest run --coverage --testTimeout=15000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:list": "playwright test --list",
    "benchmark:omr": "tsx scripts/benchmark-omr.ts",
    "benchmark:omr:sequence": "tsx scripts/evaluate-omr-sequence.ts",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "capacitor:sync": "vite build && npx cap sync && node scripts/fix-ios-spm-paths.mjs",
    "capacitor:android": "vite build && npx cap open android",
    "capacitor:ios": "vite build && npx cap open ios",
    "db:backup": "node scripts/backup-db.mjs",
    "lint:ds": "node scripts/design-system-lint.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\""
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@sentry/react": "^10.72.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-table": "^9.2.4",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.5",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.5",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.37.0",
    "mammoth": "1.12.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.1.0",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "oxlint": "^1.55.0",
    "puppeteer": "^25.9.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
