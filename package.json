{
  "name": "brave-davinci",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "clean:vite": "node -e \"import('node:fs').then(fs => fs.rmSync('node_modules/.vite',{recursive:true,force:true})).catch(() => {})\"",
    "dev": "node scripts/dev-all.mjs",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "node scripts/dev-all.mjs",
    "prebuild": "node -e \"import('node:fs').then(fs => fs.rmSync('node_modules/.vite',{recursive:true,force:true})).catch(() => {})\"",
    "build:server": "cd server && tsc",
    "build": "tsc -b && npm run build:server && vite build",
    "build:frontend": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "verify:ci": "npm run lint && npm run lint:architecture-inventory && npm run lint:ds && npm run build && npm run test:coverage -- --fileParallelism=false",
    "test": "vitest run",
    "test:security-critical": "vitest run src/__tests__/deploymentSecurityContract.test.ts server/src/__tests__/security/auth-cookie.test.ts server/src/__tests__/security/authorization-matrix-audit-b.test.ts server/src/__tests__/security/tenantIsolation.test.ts server/src/__tests__/rbac-matrix.test.ts server/src/__tests__/goliveVerification.test.ts server/src/__tests__/smokeTestPhase15.test.ts --fileParallelism=false",
    "test:coverage": "vitest run --coverage --testTimeout=15000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:list": "playwright test --list",
    "benchmark:omr": "tsx scripts/benchmark-omr.ts",
    "benchmark:omr:sequence": "tsx scripts/evaluate-omr-sequence.ts",
    "benchmark:operations": "node scripts/run-operations-benchmark.mjs",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "capacitor:sync": "vite build && npx cap sync && node scripts/fix-ios-spm-paths.mjs",
    "capacitor:android": "vite build && npx cap open android",
    "capacitor:ios": "vite build && npx cap open ios",
    "db:backup": "node scripts/backup-db.mjs",
    "audit:promotion-reconciliation": "npm --prefix server run db:audit:promotion-reconciliation",
    "audit:deployment-parish": "npm --prefix server run db:audit:deployment-parish",
    "audit:roster-integrity": "npm --prefix server run db:audit:roster-integrity",
    "audit:cross-domain-reconciliation": "npm --prefix server run db:audit:cross-domain-reconciliation",
    "audit:operations-authority": "npm --prefix server run db:audit:operations-authority",
    "audit:sunday-readiness": "npm --prefix server run notifications:audit:sunday-readiness",
    "lint:architecture-inventory": "node scripts/check-architecture-inventory.mjs",
    "lint:ds": "node scripts/design-system-lint.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\""
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@hono/node-server": "^2.0.11",
    "@hono/zod-validator": "^0.4.3",
    "@libsql/client": "^0.17.4",
    "@sentry/react": "^10.67.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^2.4.3",
    "dexie": "^4.4.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.25.0",
    "mammoth": "1.12.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.5.0",
    "@types/qrcode-generator": "^1.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "puppeteer": "^25.6.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
