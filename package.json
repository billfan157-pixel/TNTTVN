{
  "name": "brave-davinci",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\"",
    "dev": "vite",
    "prebuild": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\"",
    "build:server": "cd server && tsc",
    "build": "tsc -b && npm run build:server && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/react": "^10.67.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-table": "^8.21.3",
    "dexie": "^4.4.4",
    "lucide-react": "^1.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "oxlint": "^1.55.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "~5.8.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
