{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catevia-api",
  "main": "../../server/src/cloudflare/entry.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@libsql/client": "@libsql/client/web" },
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "placement": { "region": "aws:us-east-1" },
  "vars": {
    "CATEVIA_RUNTIME": "cloudflare-worker",
    "CATEVIA_TRAFFIC_ENABLED": "no",
    "CATEVIA_MAINTENANCE_OWNER": "render",
    "NODE_ENV": "production",
    "APP_RELEASE_ID": "unreleased",
    "DEPLOYMENT_PARISH_ID": "gia-ton",
    "PARISH_TIME_ZONE": "Asia/Ho_Chi_Minh",
    "CLIENT_ORIGIN": "https://tnttvn.vercel.app,capacitor://localhost,https://localhost",
    "AUTO_BACKUP_ENABLED": "true",
    "BACKUP_RETENTION_COUNT": "7",
    "APNS_BUNDLE_ID": "com.tnttvn.app",
    "APNS_ENVIRONMENT": "production",
    "VAPID_SUBJECT": "mailto:admin@giaoly.com"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PASSWORD_CPU", "class_name": "PasswordCpu" },
      { "name": "BACKUP_JOB", "class_name": "BackupJob" },
      { "name": "PDF_JOB", "class_name": "PdfJob" },
      { "name": "BACKEND_SHARD", "class_name": "BackendShard" },
      { "name": "MAINTENANCE_JOB", "class_name": "MaintenanceJob" }
    ]
  },
  "r2_buckets": [{ "binding": "BLOB_BUCKET", "bucket_name": "catevia-production-blobs" }],
  "browser": { "binding": "BROWSER" },
  "migrations": [
    { "tag": "password-cpu-v1", "new_sqlite_classes": ["PasswordCpu"] },
    { "tag": "backup-job-v1", "new_sqlite_classes": ["BackupJob"] },
    { "tag": "pdf-job-v1", "new_sqlite_classes": ["PdfJob"] },
    { "tag": "backend-shard-v1", "new_sqlite_classes": ["BackendShard"] },
    { "tag": "maintenance-job-v1", "new_sqlite_classes": ["MaintenanceJob"] }
  ],
  "observability": { "enabled": true }
}
