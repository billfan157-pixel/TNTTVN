{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catevia-password-cpu-local-only",
  "main": "src/catevia-password-smoke.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "CATEVIA_RUNTIME": "cloudflare-worker" },
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "PASSWORD_CPU", "class_name": "PasswordCpu" }]
  },
  "migrations": [{ "tag": "password-cpu-v1", "new_sqlite_classes": ["PasswordCpu"] }]
}
