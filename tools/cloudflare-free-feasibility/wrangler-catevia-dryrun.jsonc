{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catevia-api-dryrun-only",
  "main": "src/catevia-dryrun.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "CATEVIA_RUNTIME": "cloudflare-worker" },
  "alias": { "@libsql/client": "@libsql/client/web" },
  "durable_objects": {
    "bindings": [{ "name": "PASSWORD_CPU", "class_name": "PasswordCpu" }]
  },
  "migrations": [{ "tag": "password-cpu-v1", "new_sqlite_classes": ["PasswordCpu"] }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
