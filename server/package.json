{
  "name": "brave-davinci-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx --watch --env-file-if-exists=.env src/dev.ts",
    "dev:e2e": "tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:backup": "node ../scripts/backup-db.mjs",
    "db:preflight:cloudflare": "node --env-file-if-exists=.env --import tsx src/scripts/preflightCloudflareBackend.ts",
    "db:prepare:restore-target": "node --env-file-if-exists=.env --import tsx src/scripts/prepareRemoteRestoreTarget.ts",
    "db:restore:remote": "node --env-file-if-exists=.env --import tsx src/scripts/restoreRemoteBackup.ts",
    "db:audit:promotion-reconciliation": "node --env-file-if-exists=.env --import tsx src/scripts/auditPromotionReconciliation.ts",
    "db:audit:deployment-parish": "node --env-file-if-exists=.env --import tsx src/scripts/auditSingleParishDeployment.ts",
    "db:audit:roster-integrity": "node --env-file-if-exists=.env --import tsx src/scripts/auditRosterIntegrity.ts",
    "db:audit:cross-domain-reconciliation": "node --env-file-if-exists=.env --import tsx src/scripts/auditCrossDomainReconciliation.ts",
    "db:audit:operations-migration": "node --env-file-if-exists=.env --import tsx src/scripts/auditOperationsMigrationReadiness.ts",
    "db:audit:operations-authority": "node --env-file-if-exists=.env --import tsx src/scripts/auditOperationsAuthorityReadiness.ts",
    "notifications:audit:sunday-readiness": "node --env-file-if-exists=.env --import tsx src/scripts/auditSundayReminderReadiness.ts",
    "vapid:generate": "web-push generate-vapid-keys --json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@sentry/node": "^10.75.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "jsonwebtoken": "^9.0.2",
    "puppeteer": "^25.11.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
