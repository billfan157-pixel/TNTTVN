{
  "name": "brave-davinci-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx --watch --env-file-if-exists=.env src/index.ts",
    "dev:e2e": "tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:backup": "node ../scripts/backup-db.mjs",
    "db:restore:remote": "tsx src/scripts/restoreRemoteBackup.ts",
    "vapid:generate": "web-push generate-vapid-keys --json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@hono/node-server": "^2.0.11",
    "@hono/zod-validator": "^0.4.3",
    "@libsql/client": "^0.17.4",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "hono": "^4.13.5",
    "jsonwebtoken": "^9.0.2",
    "puppeteer": "^25.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
